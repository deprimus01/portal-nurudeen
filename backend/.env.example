# PostgreSQL connection string. On Neon specifically: use the *pooled*
# connection string here (the one with "-pooler" in the hostname, from
# Neon's dashboard → Connection Details → Pooled connection) — this is
# what the running app uses for every normal query. Append
# ?sslmode=require if Neon's UI doesn't already include it.
DATABASE_URL=postgresql://user:password@localhost:5432/nuruddeen_sms

# Neon only: the *unpooled/direct* connection string (same dashboard, minus
# "-pooler" in the hostname). Prisma Migrate needs a session-level
# connection to hold its advisory lock, which breaks under Neon's default
# PgBouncer transaction pooling — this var exists so `prisma migrate
# deploy` uses the direct connection while the app itself keeps using the
# pooled one above. Not needed against a non-pooled Postgres (e.g. plain
# Render Postgres, or local dev) — just point both vars at the same URL.
DIRECT_URL=postgresql://user:password@localhost:5432/nuruddeen_sms

# Long random string — used to sign session JWTs. Generate with:
# openssl rand -base64 48
JWT_SECRET=

# The deployed frontend's origin, for CORS. Local dev default shown.
FRONTEND_URL=http://localhost:3000

PORT=4000

# Used only by prisma/seed.js to create the very first admin account.
# Override these before running the seed in production — never leave the
# default password in place.
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!

# Set to "true" to also seed one demo Teacher, Guardian, and Student
# account (each with a working portal login) when you run `npm run seed`.
# Useful for local dev/testing so every role can be logged into right
# away — leave unset (or "false") in production. All demo records use
# fixed demo.* emails so they're easy to find and delete later.
SEED_DEMO_ACCOUNTS=false
SEED_DEMO_PASSWORD=DemoPass123!

# Resend (https://resend.com) — used for all outbound email: account
# credential delivery, announcement notifications, new-message alerts.
# EMAIL_FROM must be a verified sender/domain in your Resend account, or
# use the default onboarding@resend.dev sandbox address for testing.
RESEND_API_KEY=
EMAIL_FROM=Nuruddeen Schools Gusau <onboarding@resend.dev>

# Termii (https://termii.com) — used for all outbound SMS, sent alongside
# email for every notification type (credentials, password resets,
# announcements, new-message alerts). This is the primary channel for iOS
# parents, whose PWA push support is limited (see PRD §1.4). TERMII_SENDER_ID
# must be a registered/approved Sender ID in your Termii account — using an
# unapproved one causes sends to silently fail on some routes. Without
# TERMII_API_KEY set, SMS sends fail and log to the Delivery Log the same
# way a misconfigured Resend key does; email still goes out as normal.
TERMII_API_KEY=
TERMII_SENDER_ID=N-Alert

# Shared secret checked by requireCronSecret (see middleware/cronAuth.js)
# for scheduled-job endpoints under /api/cron — e.g. marking overdue
# invoices. Not a user session, so this is checked instead of a JWT.
# Generate with: openssl rand -base64 32
# Must match the secret configured in the GitHub Actions workflow that
# calls these endpoints (see .github/workflows/mark-invoices-overdue.yml).
CRON_SECRET=

# Domain used for synthetic student login emails (students have no real
# email on file — see the "Provision" action on the Students page).
# Handles are name-based, e.g. johndoe@student.nurudeen (see
# src/lib/studentLogin.js) — never a real mailbox, so the domain doesn't
# need to exist or be owned by you. Defaults to a clearly-placeholder
# value; update once you own the real domain. No code change needed
# either way.
STUDENT_LOGIN_EMAIL_DOMAIN=student.nurudeen

# Groq (https://console.groq.com/keys) — powers the Phase 7 AI Assistant
# (report card comment drafts, parent Q&A). Deliberately a separate key
# from the public website's chatbot — this one touches real student data
# behind auth. Without this set, AI routes respond with a clean "not
# configured yet" error instead of crashing.
GROQ_API_KEY=

# OAuth signing keys for SSO with the CMS (nurudeen-schools) — ADR-001.
# Generate with: node scripts/generate-oauth-keys.js
# Deliberately asymmetric and separate from JWT_SECRET above (ADR-001 §2
# refinement 1 / §6: a shared symmetric secret was explicitly rejected).
# Optional at boot — Phase 0 is being rolled out incrementally, so routes
# that need these return a clean 503 until they're set, rather than
# blocking the rest of the SMS from starting. The public key is served
# automatically at GET /oauth/jwks.json once these are set; never paste
# it into the CMS's own env — the CMS fetches it from that endpoint.
OAUTH_KEY_ID=
OAUTH_PRIVATE_KEY_BASE64=
OAUTH_PUBLIC_KEY_BASE64=

# The CMS's (nurudeen-schools) registered OAuth client — ADR-001 §4/§7.
# One hardcoded client, not a DB table of clients: this SMS acts as
# Identity Provider for exactly one Relying Party. OAUTH_CMS_REDIRECT_URI
# must match EXACTLY what the CMS calls back to (no prefix/substring
# matching is done) — this is the allow-list that makes it safe to trust
# redirect_uri from an incoming /oauth/authorize request. Until both are
# set, /oauth/authorize responds 503 rather than accepting requests it
# can't validate.
OAUTH_CMS_CLIENT_ID=
OAUTH_CMS_REDIRECT_URI=

# Shared secret for the server-to-server POST /oauth/token exchange
# (RFC 6749 §2.3.1 confidential client). Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# The CMS's backend needs the SAME value under its own env var name to
# send back during token exchange — this is the one piece of the OAuth
# setup that must be copied between the two repos' environments (unlike
# the JWKS public key, which the CMS fetches automatically).
OAUTH_CMS_CLIENT_SECRET=
